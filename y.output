Grammar

    0 $accept: Program $end

    1 Program: TDeclBlock ClassDefBlock GDeclBlock FDefBlock MainBlock
    2        | TDeclBlock ClassDefBlock GDeclBlock MainBlock
    3        | TDeclBlock MainBlock

    4 GDeclBlock: DECL GDeclList ENDDECL
    5           | DECL ENDDECL

    6 GDeclList: GDeclList GDecl
    7          | GDecl

    8 GDecl: Type GidList ';'

    9 GidList: GidList ',' Gid
   10        | Gid

   11 Gid: ID DimList
   12    | MUL ID
   13    | ID '(' ParamdeclBlock ')'
   14    | MUL ID '(' ParamdeclBlock ')'

   15 TDeclBlock: TYPE TDeclList ENDTYPE
   16           | %empty

   17 TDeclList: TDeclList TDecl
   18          | TDecl

   19 TDeclStart: TUPLE ID
   20           | STRUCT ID

   21 TDecl: TDeclStart '{' TIdList ';' '}' ';'

   22 TIdList: TIdList ';' TIdDecl
   23        | TIdDecl

   24 TIdDecl: Type ID

   25 ClassDefBlock: CLASS ClassDefList ENDCLASS
   26              | CLASS ENDCLASS

   27 ClassDefList: ClassDefList Classdef
   28             | Classdef

   29 Classdef: Cname '{' DECL ClassdeclList ENDDECL MethodDefns '}'

   30 ClassdeclList: Fieldlists MethodDecl

   31 Cname: ID
   32      | ID EXTENDS ID

   33 Fieldlists: Fieldlists Fld
   34           | %empty

   35 Fld: Type ID ';'

   36 MethodDecl: MethodDecl MDecl
   37           | MDecl

   38 MDecl: Type ID '(' ParamdeclBlock ')' ';'

   39 MethodDefns: MethodDefns Fdef
   40            | Fdef

   41 FieldFunction: SELF '.' ID '(' ArgList ')'
   42              | ID '.' ID '(' ArgList ')'
   43              | Field '.' ID '(' ArgList ')'

   44 FDefBlock: FDefBlock Fdef
   45          | Fdef

   46 Fdef: Type ID '(' ParamdeclBlock ')' '{' LdeclBlock body '}'
   47     | Type MUL ID '(' ParamdeclBlock ')' '{' LdeclBlock body '}'

   48 ParamdeclBlock: Paramlist

   49 Paramlist: Paramlist ',' ParamDecl
   50          | ParamDecl
   51          | %empty

   52 ParamDecl: Type Param

   53 Param: ID
   54      | MUL ID

   55 LdeclBlock: DECL LDecList ENDDECL
   56           | %empty

   57 LDecList: LDecList LDecl
   58         | LDecl

   59 LDecl: Type IdList ';'

   60 IdList: IdList ',' IdDecl
   61       | IdDecl

   62 IdDecl: ID
   63       | MUL ID

   64 ArgList: ArgList ',' E
   65        | E
   66        | %empty

   67 MainBlock: Type MAIN '(' ')' '{' LdeclBlock body '}'

   68 body: begin Slist end

   69 Slist: Slist Stmt
   70      | Stmt

   71 Type: INT
   72     | STR
   73     | ID

   74 DimList: DimList '[' NUM ']'
   75        | %empty

   76 InputStmt: READ '(' ID ')' ';'
   77          | READ '(' ID DimAccess ')' ';'
   78          | READ '(' MUL ID ')' ';'
   79          | READ '(' Field ')' ';'
   80          | READ '(' ID ARROW ID ')' ';'

   81 OutputStmt: WRITE '(' E ')' ';'

   82 AsgStmt: ID '=' E ';'
   83        | ID DimAccess '=' E ';'
   84        | MUL ID '=' E ';'
   85        | Field '=' E ';'
   86        | ID ARROW ID '=' E ';'

   87 Allocstmnt: ID '=' ALLOC '(' ')' ';'
   88           | Field '=' ALLOC '(' ')' ';'
   89           | FREE '(' ID ')' ';'
   90           | FREE '(' Field ')' ';'
   91           | INITIALIZE '(' ')' ';'
   92           | ID '=' NEW '(' ID ')' ';'
   93           | Field '=' NEW '(' ID ')' ';'
   94           | DELETE '(' ID ')' ';'
   95           | DELETE '(' Field ')' ';'

   96 Stmt: InputStmt
   97     | OutputStmt
   98     | AsgStmt
   99     | Ifstmt
  100     | Whilestmt
  101     | DoWhilestmt
  102     | RepeatUntiltstmt
  103     | Jumpstmt
  104     | Debugstmt
  105     | Allocstmnt
  106     | FieldFunction ';'

  107 Ifstmt: IF '(' E ')' THEN Slist ELSE Slist ENDIF ';'
  108       | IF '(' E ')' THEN Slist ENDIF ';'

  109 Whilestmt: WHILE '(' E ')' DO Slist ENDWHILE ';'

  110 DoWhilestmt: DO Slist WHILE '(' E ')' ';'

  111 RepeatUntiltstmt: REPEAT Slist UNTIL '(' E ')' ';'

  112 Jumpstmt: CONTINUE ';'
  113         | BREAK ';'
  114         | RETURN E ';'

  115 Debugstmt: BREAKPOINT ';'

  116 E: E PLUS E
  117  | E MINUS E
  118  | E DIV E
  119  | E MUL E
  120  | E MOD E
  121  | '(' E ')'
  122  | E GT E
  123  | E LT E
  124  | E GE E
  125  | E LE E
  126  | E NE E
  127  | E EQ E
  128  | E AND E
  129  | E OR E
  130  | NILL
  131  | Field
  132  | FieldFunction
  133  | ID ARROW ID
  134  | ID '(' ArgList ')'
  135  | ID
  136  | ID DimAccess
  137  | MUL ID
  138  | '&' ID
  139  | STRING
  140  | NUM
  141  | MINUS NUM

  142 DimAccess: DimAccess '[' E ']'
  143          | '[' E ']'

  144 Field: Field '.' ID
  145      | ID '.' ID
  146      | SELF '.' ID


