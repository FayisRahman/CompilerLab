Grammar

    0 $accept: Program $end

    1 Program: TDeclBlock GDeclBlock FDefBlock MainBlock
    2        | TDeclBlock GDeclBlock MainBlock
    3        | TDeclBlock MainBlock

    4 GDeclBlock: DECL GDeclList ENDDECL
    5           | DECL ENDDECL

    6 GDeclList: GDeclList GDecl
    7          | GDecl

    8 GDecl: Type GidList ';'

    9 GidList: GidList ',' Gid
   10        | Gid

   11 Gid: ID DimList
   12    | MUL ID
   13    | ID '(' Paramlist ')'
   14    | MUL ID '(' Paramlist ')'

   15 TDeclBlock: TYPE TDeclList ENDTYPE
   16           | %empty

   17 TDeclList: TDeclList TDecl
   18          | TDecl

   19 TDecl: TUPLE ID '{' TIdList '}' ';'

   20 TIdList: TIdList ';' TIdDecl
   21        | TIdDecl

   22 TIdDecl: Type ID

   23 FDefBlock: FDefBlock Fdef
   24          | Fdef

   25 Fdef: Type ID '(' Paramlist ')' '{' LdeclBlock body '}'
   26     | Type MUL ID '(' Paramlist ')' '{' LdeclBlock body '}'

   27 Paramlist: Paramlist ',' ParamDecl
   28          | ParamDecl
   29          | %empty

   30 ParamDecl: Type Param

   31 Param: ID
   32      | MUL ID

   33 LdeclBlock: DECL LDecList ENDDECL
   34           | %empty

   35 LDecList: LDecList LDecl
   36         | LDecl

   37 LDecl: Type IdList ';'

   38 IdList: IdList ',' IdDecl
   39       | IdDecl

   40 IdDecl: ID
   41       | MUL ID

   42 ArgList: ArgList ',' E
   43        | E

   44 MainBlock: Type MAIN '(' ')' '{' LdeclBlock body '}'

   45 body: begin Slist end

   46 Slist: Slist Stmt
   47      | Stmt

   48 Type: INT
   49     | STR
   50     | ID

   51 DimList: DimList '[' NUM ']'
   52        | %empty

   53 InputStmt: READ '(' ID ')' ';'
   54          | READ '(' ID DimAccess ')' ';'
   55          | READ '(' MUL ID ')' ';'

   56 OutputStmt: WRITE '(' E ')' ';'

   57 AsgStmt: ID '=' E ';'
   58        | ID DimAccess '=' E ';'
   59        | MUL ID '=' E ';'
   60        | ID '.' ID '=' E ';'
   61        | ID ARROW ID '=' E ';'

   62 Stmt: InputStmt
   63     | OutputStmt
   64     | AsgStmt
   65     | Ifstmt
   66     | Whilestmt
   67     | DoWhilestmt
   68     | RepeatUntiltstmt
   69     | Jumpstmt
   70     | Debugstmt

   71 Ifstmt: IF '(' E ')' THEN Slist ELSE Slist ENDIF ';'
   72       | IF '(' E ')' THEN Slist ENDIF ';'

   73 Whilestmt: WHILE '(' E ')' DO Slist ENDWHILE ';'

   74 DoWhilestmt: DO Slist WHILE '(' E ')' ';'

   75 RepeatUntiltstmt: REPEAT Slist UNTIL '(' E ')' ';'

   76 Jumpstmt: CONTINUE ';'
   77         | BREAK ';'
   78         | RETURN E ';'

   79 Debugstmt: BREAKPOINT ';'

   80 E: E PLUS E
   81  | E MINUS E
   82  | E DIV E
   83  | E MUL E
   84  | E MOD E
   85  | '(' E ')'
   86  | E GT E
   87  | E LT E
   88  | E GE E
   89  | E LE E
   90  | E NE E
   91  | E EQ E
   92  | E AND E
   93  | E OR E
   94  | ID '.' ID
   95  | ID ARROW ID
   96  | ID '(' ')'
   97  | ID '(' ArgList ')'
   98  | ID
   99  | ID DimAccess
  100  | MUL ID
  101  | '&' ID
  102  | STRING
  103  | NUM
  104  | MINUS NUM

  105 DimAccess: DimAccess '[' E ']'
  106          | '[' E ']'


