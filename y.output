Grammar

    0 $accept: Program $end

    1 Program: GDeclBlock FDefBlock MainBlock
    2        | GDeclBlock MainBlock
    3        | MainBlock

    4 GDeclBlock: DECL GDeclList ENDDECL
    5           | DECL ENDDECL

    6 GDeclList: GDeclList GDecl
    7          | GDecl

    8 GDecl: Type GidList ';'

    9 GidList: GidList ',' Gid
   10        | Gid

   11 Gid: ID DimList
   12    | MUL ID
   13    | ID '(' Paramlist ')'
   14    | MUL ID '(' Paramlist ')'

   15 FDefBlock: FDefBlock Fdef
   16          | Fdef

   17 Fdef: Type ID '(' Paramlist ')' '{' LdeclBlock body '}'
   18     | Type MUL ID '(' Paramlist ')' '{' LdeclBlock body '}'

   19 Paramlist: Paramlist ',' ParamDecl
   20          | ParamDecl
   21          | %empty

   22 ParamDecl: Type Param

   23 Param: ID
   24      | MUL ID

   25 LdeclBlock: DECL LDecList ENDDECL
   26           | %empty

   27 LDecList: LDecList LDecl
   28         | LDecl

   29 LDecl: Type IdList ';'

   30 IdList: IdList ',' IdDecl
   31       | IdDecl

   32 IdDecl: ID
   33       | MUL ID

   34 ArgList: ArgList ',' E
   35        | E

   36 MainBlock: Type MAIN '(' ')' '{' LdeclBlock body '}'

   37 body: begin Slist end

   38 Slist: Slist Stmt
   39      | Stmt

   40 Type: INT
   41     | STR

   42 DimList: DimList '[' NUM ']'
   43        | %empty

   44 InputStmt: READ '(' ID ')' ';'
   45          | READ '(' ID DimAccess ')' ';'
   46          | READ '(' MUL ID ')' ';'

   47 OutputStmt: WRITE '(' E ')' ';'

   48 AsgStmt: ID '=' E ';'
   49        | ID DimAccess '=' E ';'
   50        | MUL ID '=' E ';'

   51 Stmt: InputStmt
   52     | OutputStmt
   53     | AsgStmt
   54     | Ifstmt
   55     | Whilestmt
   56     | DoWhilestmt
   57     | RepeatUntiltstmt
   58     | Jumpstmt
   59     | Debugstmt

   60 Ifstmt: IF '(' E ')' THEN Slist ELSE Slist ENDIF ';'
   61       | IF '(' E ')' THEN Slist ENDIF ';'

   62 Whilestmt: WHILE '(' E ')' DO Slist ENDWHILE ';'

   63 DoWhilestmt: DO Slist WHILE '(' E ')' ';'

   64 RepeatUntiltstmt: REPEAT Slist UNTIL '(' E ')' ';'

   65 Jumpstmt: CONTINUE ';'
   66         | BREAK ';'
   67         | RETURN E ';'

   68 Debugstmt: BREAKPOINT ';'

   69 E: E PLUS E
   70  | E MINUS E
   71  | E DIV E
   72  | E MUL E
   73  | E MOD E
   74  | '(' E ')'
   75  | E GT E
   76  | E LT E
   77  | E GE E
   78  | E LE E
   79  | E NE E
   80  | E EQ E
   81  | E AND E
   82  | E OR E
   83  | ID '(' ')'
   84  | ID '(' ArgList ')'
   85  | ID
   86  | ID DimAccess
   87  | MUL ID
   88  | '&' ID
   89  | STRING
   90  | NUM
   91  | MINUS NUM

   92 DimAccess: DimAccess '[' E ']'
   93          | '[' E ']'


