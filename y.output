Grammar

    0 $accept: Program $end

    1 Program: TDeclBlock ClassDefBlock GDeclBlock FDefBlock MainBlock
    2        | TDeclBlock GDeclBlock MainBlock
    3        | TDeclBlock MainBlock

    4 GDeclBlock: DECL GDeclList ENDDECL
    5           | DECL ENDDECL

    6 GDeclList: GDeclList GDecl
    7          | GDecl

    8 GDecl: Type GidList ';'

    9 GidList: GidList ',' Gid
   10        | Gid

   11 Gid: ID DimList
   12    | MUL ID
   13    | ID '(' Paramlist ')'
   14    | MUL ID '(' Paramlist ')'

   15 TDeclBlock: TYPE TDeclList ENDTYPE
   16           | %empty

   17 TDeclList: TDeclList TDecl
   18          | TDecl

   19 TDeclStart: TUPLE ID
   20           | STRUCT ID

   21 TDecl: TDeclStart '{' TIdList ';' '}' ';'

   22 TIdList: TIdList ';' TIdDecl
   23        | TIdDecl

   24 TIdDecl: Type ID

   25 ClassDefBlock: CLASS ClassDefList ENDCLASS
   26              | CLASS ENDCLASS

   27 ClassDefList: ClassDefList Classdef
   28             | Classdef

   29 Classdef: Cname '{' DECL Fieldlists MethodDecl ENDDECL MethodDefns '}'

   30 Cname: ID
   31      | ID EXTENDS ID

   32 Fieldlists: Fieldlists Fld
   33           | %empty

   34 Fld: ID ID ';'

   35 MethodDecl: MethodDecl MDecl
   36           | MDecl

   37 MDecl: ID ID '(' Paramlist ')' ';'

   38 MethodDefns: MethodDefns Fdef
   39            | Fdef

   40 FDefBlock: FDefBlock Fdef
   41          | Fdef

   42 Fdef: Type ID '(' Paramlist ')' '{' LdeclBlock body '}'
   43     | Type MUL ID '(' Paramlist ')' '{' LdeclBlock body '}'

   44 Paramlist: Paramlist ',' ParamDecl
   45          | ParamDecl
   46          | %empty

   47 ParamDecl: Type Param

   48 Param: ID
   49      | MUL ID

   50 LdeclBlock: DECL LDecList ENDDECL
   51           | %empty

   52 LDecList: LDecList LDecl
   53         | LDecl

   54 LDecl: Type IdList ';'

   55 IdList: IdList ',' IdDecl
   56       | IdDecl

   57 IdDecl: ID
   58       | MUL ID

   59 ArgList: ArgList ',' E
   60        | E

   61 MainBlock: Type MAIN '(' ')' '{' LdeclBlock body '}'

   62 body: begin Slist end

   63 Slist: Slist Stmt
   64      | Stmt

   65 Type: INT
   66     | STR
   67     | ID

   68 DimList: DimList '[' NUM ']'
   69        | %empty

   70 InputStmt: READ '(' ID ')' ';'
   71          | READ '(' ID DimAccess ')' ';'
   72          | READ '(' MUL ID ')' ';'
   73          | READ '(' Field ')' ';'
   74          | READ '(' ID ARROW ID ')' ';'

   75 OutputStmt: WRITE '(' E ')' ';'

   76 AsgStmt: ID '=' E ';'
   77        | ID DimAccess '=' E ';'
   78        | MUL ID '=' E ';'
   79        | Field '=' E ';'
   80        | ID ARROW ID '=' E ';'

   81 Allocstmnt: ID '=' ALLOC '(' ')' ';'
   82           | Field '=' ALLOC '(' ')' ';'
   83           | FREE '(' ID ')' ';'
   84           | FREE '(' Field ')' ';'
   85           | INITIALIZE '(' ')' ';'

   86 Stmt: InputStmt
   87     | OutputStmt
   88     | AsgStmt
   89     | Ifstmt
   90     | Whilestmt
   91     | DoWhilestmt
   92     | RepeatUntiltstmt
   93     | Jumpstmt
   94     | Debugstmt
   95     | Allocstmnt

   96 Ifstmt: IF '(' E ')' THEN Slist ELSE Slist ENDIF ';'
   97       | IF '(' E ')' THEN Slist ENDIF ';'

   98 Whilestmt: WHILE '(' E ')' DO Slist ENDWHILE ';'

   99 DoWhilestmt: DO Slist WHILE '(' E ')' ';'

  100 RepeatUntiltstmt: REPEAT Slist UNTIL '(' E ')' ';'

  101 Jumpstmt: CONTINUE ';'
  102         | BREAK ';'
  103         | RETURN E ';'

  104 Debugstmt: BREAKPOINT ';'

  105 E: E PLUS E
  106  | E MINUS E
  107  | E DIV E
  108  | E MUL E
  109  | E MOD E
  110  | '(' E ')'
  111  | E GT E
  112  | E LT E
  113  | E GE E
  114  | E LE E
  115  | E NE E
  116  | E EQ E
  117  | E AND E
  118  | E OR E
  119  | NILL
  120  | Field
  121  | ID ARROW ID
  122  | ID '(' ')'
  123  | ID '(' ArgList ')'
  124  | ID
  125  | ID DimAccess
  126  | MUL ID
  127  | '&' ID
  128  | STRING
  129  | NUM
  130  | MINUS NUM

  131 DimAccess: DimAccess '[' E ']'
  132          | '[' E ']'

  133 Field: Field '.' ID
  134      | ID '.' ID


