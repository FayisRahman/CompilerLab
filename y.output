Grammar

    0 $accept: Program $end

    1 Program: TDeclBlock GDeclBlock FDefBlock MainBlock
    2        | TDeclBlock GDeclBlock MainBlock
    3        | TDeclBlock MainBlock

    4 GDeclBlock: DECL GDeclList ENDDECL
    5           | DECL ENDDECL

    6 GDeclList: GDeclList GDecl
    7          | GDecl

    8 GDecl: Type GidList ';'

    9 GidList: GidList ',' Gid
   10        | Gid

   11 Gid: ID DimList
   12    | MUL ID
   13    | ID '(' Paramlist ')'
   14    | MUL ID '(' Paramlist ')'

   15 TDeclBlock: TYPE TDeclList ENDTYPE
   16           | %empty

   17 TDeclList: TDeclList TDecl
   18          | TDecl

   19 TDeclStart: TUPLE ID
   20           | STRUCT ID

   21 TDecl: TDeclStart '{' TIdList ';' '}' ';'

   22 TIdList: TIdList ';' TIdDecl
   23        | TIdDecl

   24 TIdDecl: Type ID

   25 FDefBlock: FDefBlock Fdef
   26          | Fdef

   27 Fdef: Type ID '(' Paramlist ')' '{' LdeclBlock body '}'
   28     | Type MUL ID '(' Paramlist ')' '{' LdeclBlock body '}'

   29 Paramlist: Paramlist ',' ParamDecl
   30          | ParamDecl
   31          | %empty

   32 ParamDecl: Type Param

   33 Param: ID
   34      | MUL ID

   35 LdeclBlock: DECL LDecList ENDDECL
   36           | %empty

   37 LDecList: LDecList LDecl
   38         | LDecl

   39 LDecl: Type IdList ';'

   40 IdList: IdList ',' IdDecl
   41       | IdDecl

   42 IdDecl: ID
   43       | MUL ID

   44 ArgList: ArgList ',' E
   45        | E

   46 MainBlock: Type MAIN '(' ')' '{' LdeclBlock body '}'

   47 body: begin Slist end

   48 Slist: Slist Stmt
   49      | Stmt

   50 Type: INT
   51     | STR
   52     | ID

   53 DimList: DimList '[' NUM ']'
   54        | %empty

   55 InputStmt: READ '(' ID ')' ';'
   56          | READ '(' ID DimAccess ')' ';'
   57          | READ '(' MUL ID ')' ';'
   58          | READ '(' Field ')' ';'
   59          | READ '(' ID ARROW ID ')' ';'

   60 OutputStmt: WRITE '(' E ')' ';'

   61 AsgStmt: ID '=' E ';'
   62        | ID DimAccess '=' E ';'
   63        | MUL ID '=' E ';'
   64        | Field '=' E ';'
   65        | ID ARROW ID '=' E ';'

   66 Allocstmnt: ID '=' ALLOC '(' ')' ';'
   67           | Field '=' ALLOC '(' ')' ';'
   68           | FREE '(' ID ')' ';'
   69           | FREE '(' Field ')' ';'
   70           | INITIALIZE '(' ')' ';'

   71 Stmt: InputStmt
   72     | OutputStmt
   73     | AsgStmt
   74     | Ifstmt
   75     | Whilestmt
   76     | DoWhilestmt
   77     | RepeatUntiltstmt
   78     | Jumpstmt
   79     | Debugstmt
   80     | Allocstmnt

   81 Ifstmt: IF '(' E ')' THEN Slist ELSE Slist ENDIF ';'
   82       | IF '(' E ')' THEN Slist ENDIF ';'

   83 Whilestmt: WHILE '(' E ')' DO Slist ENDWHILE ';'

   84 DoWhilestmt: DO Slist WHILE '(' E ')' ';'

   85 RepeatUntiltstmt: REPEAT Slist UNTIL '(' E ')' ';'

   86 Jumpstmt: CONTINUE ';'
   87         | BREAK ';'
   88         | RETURN E ';'

   89 Debugstmt: BREAKPOINT ';'

   90 E: E PLUS E
   91  | E MINUS E
   92  | E DIV E
   93  | E MUL E
   94  | E MOD E
   95  | '(' E ')'
   96  | E GT E
   97  | E LT E
   98  | E GE E
   99  | E LE E
  100  | E NE E
  101  | E EQ E
  102  | E AND E
  103  | E OR E
  104  | NILL
  105  | Field
  106  | ID ARROW ID
  107  | ID '(' ')'
  108  | ID '(' ArgList ')'
  109  | ID
  110  | ID DimAccess
  111  | MUL ID
  112  | '&' ID
  113  | STRING
  114  | NUM
  115  | MINUS NUM

  116 DimAccess: DimAccess '[' E ']'
  117          | '[' E ']'

  118 Field: Field '.' ID
  119      | ID '.' ID


