Grammar

    0 $accept: Program $end

    1 Program: TDeclBlock GDeclBlock FDefBlock MainBlock
    2        | TDeclBlock GDeclBlock MainBlock
    3        | TDeclBlock MainBlock

    4 GDeclBlock: DECL GDeclList ENDDECL
    5           | DECL ENDDECL

    6 GDeclList: GDeclList GDecl
    7          | GDecl

    8 GDecl: Type GidList ';'

    9 GidList: GidList ',' Gid
   10        | Gid

   11 Gid: ID DimList
   12    | MUL ID
   13    | ID '(' Paramlist ')'
   14    | MUL ID '(' Paramlist ')'

   15 TDeclBlock: TYPE TDeclList ENDTYPE
   16           | %empty

   17 TDeclList: TDeclList TDecl
   18          | TDecl

   19 TDeclStart: TUPLE ID

   20 TDecl: TDeclStart '{' TIdList ';' '}' ';'

   21 TIdList: TIdList ';' TIdDecl
   22        | TIdDecl

   23 TIdDecl: Type ID

   24 FDefBlock: FDefBlock Fdef
   25          | Fdef

   26 Fdef: Type ID '(' Paramlist ')' '{' LdeclBlock body '}'
   27     | Type MUL ID '(' Paramlist ')' '{' LdeclBlock body '}'

   28 Paramlist: Paramlist ',' ParamDecl
   29          | ParamDecl
   30          | %empty

   31 ParamDecl: Type Param

   32 Param: ID
   33      | MUL ID

   34 LdeclBlock: DECL LDecList ENDDECL
   35           | %empty

   36 LDecList: LDecList LDecl
   37         | LDecl

   38 LDecl: Type IdList ';'

   39 IdList: IdList ',' IdDecl
   40       | IdDecl

   41 IdDecl: ID
   42       | MUL ID

   43 ArgList: ArgList ',' E
   44        | E

   45 MainBlock: Type MAIN '(' ')' '{' LdeclBlock body '}'

   46 body: begin Slist end

   47 Slist: Slist Stmt
   48      | Stmt

   49 Type: INT
   50     | STR
   51     | ID

   52 DimList: DimList '[' NUM ']'
   53        | %empty

   54 InputStmt: READ '(' ID ')' ';'
   55          | READ '(' ID DimAccess ')' ';'
   56          | READ '(' MUL ID ')' ';'
   57          | READ '(' ID '.' ID ')' ';'
   58          | READ '(' ID ARROW ID ')' ';'

   59 OutputStmt: WRITE '(' E ')' ';'

   60 AsgStmt: ID '=' E ';'
   61        | ID DimAccess '=' E ';'
   62        | MUL ID '=' E ';'
   63        | ID '.' ID '=' E ';'
   64        | ID ARROW ID '=' E ';'

   65 Stmt: InputStmt
   66     | OutputStmt
   67     | AsgStmt
   68     | Ifstmt
   69     | Whilestmt
   70     | DoWhilestmt
   71     | RepeatUntiltstmt
   72     | Jumpstmt
   73     | Debugstmt

   74 Ifstmt: IF '(' E ')' THEN Slist ELSE Slist ENDIF ';'
   75       | IF '(' E ')' THEN Slist ENDIF ';'

   76 Whilestmt: WHILE '(' E ')' DO Slist ENDWHILE ';'

   77 DoWhilestmt: DO Slist WHILE '(' E ')' ';'

   78 RepeatUntiltstmt: REPEAT Slist UNTIL '(' E ')' ';'

   79 Jumpstmt: CONTINUE ';'
   80         | BREAK ';'
   81         | RETURN E ';'

   82 Debugstmt: BREAKPOINT ';'

   83 E: E PLUS E
   84  | E MINUS E
   85  | E DIV E
   86  | E MUL E
   87  | E MOD E
   88  | '(' E ')'
   89  | E GT E
   90  | E LT E
   91  | E GE E
   92  | E LE E
   93  | E NE E
   94  | E EQ E
   95  | E AND E
   96  | E OR E
   97  | ID '.' ID
   98  | ID ARROW ID
   99  | ID '(' ')'
  100  | ID '(' ArgList ')'
  101  | ID
  102  | ID DimAccess
  103  | MUL ID
  104  | '&' ID
  105  | STRING
  106  | NUM
  107  | MINUS NUM

  108 DimAccess: DimAccess '[' E ']'
  109          | '[' E ']'


