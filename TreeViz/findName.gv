digraph AST {
  node [fontname="Arial"];
  n1 [label="RETURN\ntype: 2", shape=box, style=rounded, color=blue];
  n1 -> n2 [label="left"];
  n2 [label="DOT\nvar: name\ntype: 2", shape=box, style=rounded, color=blue];
  n2 -> n3 [label="left"];
  n3 [label="NULL\nvar: self", shape=box, style=rounded, color=blue];
  n2 -> n4 [label="right"];
  n4 [label="LEAF\nvar: name\ntype: 4", shape=box, style=rounded, color=blue];
}
